# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API). NUNCA subas .env.local a GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo servidor: se usa para invitar clientes. No la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# URL pública de la app (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: token de Decolecta (decolecta.com) para buscar RUC 10 y 20 en línea.
# Sin token, la búsqueda usa OpenRUC (gratis, solo RUC 20).
DECOLECTA_TOKEN=
